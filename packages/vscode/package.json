{
  "name": "promptback-vscode",
  "displayName": "Promptback",
  "description": "Semantic search over every prompt you've sent to your AI coding agents: Copilot CLI, the VS Code Agents window, autopilot and Chat. Local-first.",
  "version": "0.5.1",
  "private": true,
  "publisher": "spencrr",
  "repository": {
    "type": "git",
    "url": "https://github.com/spencrr/promptback"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "copilot",
    "prompts",
    "history",
    "semantic search",
    "agents"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "promptback.search",
        "title": "Quick Search",
        "category": "Promptback",
        "icon": "$(search)"
      },
      {
        "command": "promptback.openExplorer",
        "title": "Open Prompt Explorer",
        "category": "Promptback",
        "icon": "$(table)"
      },
      {
        "command": "promptback.openIndexPanel",
        "title": "Index & Model Settings",
        "category": "Promptback",
        "icon": "$(settings-gear)"
      },
      {
        "command": "promptback.searchAll",
        "title": "Quick Search (Including Agent, Skill and System Messages)",
        "category": "Promptback"
      },
      {
        "command": "promptback.reindex",
        "title": "Re-scan and Index Now",
        "category": "Promptback",
        "icon": "$(sync)"
      },
      {
        "command": "promptback.showStatus",
        "title": "Show Index Status",
        "category": "Promptback",
        "icon": "$(info)"
      },
      {
        "command": "promptback.showLog",
        "title": "Show Log",
        "category": "Promptback"
      },
      {
        "command": "promptback.enableInAgentsWindow",
        "title": "Enable in Agents Window",
        "category": "Promptback"
      },
      {
        "command": "promptback.refreshSidebar",
        "title": "Refresh",
        "category": "Promptback",
        "icon": "$(refresh)"
      },
      {
        "command": "promptback.revealPrompt",
        "title": "Show in Prompt Explorer",
        "category": "Promptback",
        "icon": "$(table)"
      },
      {
        "command": "promptback.copyPromptFromTree",
        "title": "Copy Prompt",
        "category": "Promptback",
        "icon": "$(copy)"
      },
      {
        "command": "promptback.openSessionFromTree",
        "title": "Open Session",
        "category": "Promptback",
        "icon": "$(link-external)"
      }
    ],
    "keybindings": [
      {
        "command": "promptback.search",
        "key": "ctrl+alt+h",
        "mac": "cmd+ctrl+h"
      },
      {
        "command": "promptback.openExplorer",
        "key": "ctrl+alt+e",
        "mac": "cmd+ctrl+e"
      }
    ],
    "configuration": [
      {
        "id": "general",
        "title": "General",
        "order": 1,
        "properties": {
          "promptback.defaultAction": {
            "type": "string",
            "enum": [
              "copy",
              "insert",
              "preview",
              "open"
            ],
            "enumDescriptions": [
              "Copy the prompt to the clipboard",
              "Insert the prompt into the chat input (without sending)",
              "Open the full prompt in a read-only editor",
              "Open or resume the session the prompt came from"
            ],
            "default": "copy",
            "description": "What Enter does on a search result.",
            "order": 0
          },
          "promptback.maxResults": {
            "type": "number",
            "default": 50,
            "minimum": 5,
            "maximum": 500,
            "description": "Maximum results shown in the search picker.",
            "order": 1
          },
          "promptback.mcp.enabled": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Offer the Promptback MCP server to chat agents in VS Code, including the Agents window, so they can search and read your past prompts (and send what they find to their model). Skipped while Copilot CLI's `mcp-config.json` defines a `promptback` server: Copilot sessions use that entry instead.",
            "order": 2
          }
        }
      },
      {
        "id": "sources",
        "title": "Sources",
        "order": 2,
        "properties": {
          "promptback.sources.copilot": {
            "type": "boolean",
            "default": true,
            "description": "Index Copilot sessions (Agents window, Copilot CLI, autopilot).",
            "order": 0
          },
          "promptback.sources.copilotHome": {
            "type": "string",
            "default": "",
            "markdownDescription": "Copilot home folder (default `$COPILOT_HOME` or `~/.copilot`).",
            "order": 1
          },
          "promptback.sources.vscodeChat": {
            "type": "boolean",
            "default": true,
            "description": "Index VS Code Chat panel history (Stable and Insiders).",
            "order": 2
          },
          "promptback.sources.agentHost": {
            "type": "boolean",
            "default": true,
            "description": "Link Copilot sessions to the Agents-window sessions that wrap them (adds \"Open in Agents window\" and the window's title).",
            "order": 3
          },
          "promptback.sources.claudeCode": {
            "type": "boolean",
            "default": true,
            "description": "Index Claude Code sessions (CLI, Agent SDK and VS Code extension).",
            "order": 4
          },
          "promptback.sources.claudeCodeHome": {
            "type": "string",
            "default": "",
            "markdownDescription": "Claude Code configuration folder (default `$CLAUDE_CONFIG_DIR` or `~/.claude`).",
            "order": 5
          },
          "promptback.sources.codex": {
            "type": "boolean",
            "default": true,
            "description": "Index OpenAI Codex threads (CLI, exec and VS Code).",
            "order": 6
          },
          "promptback.sources.codexHome": {
            "type": "string",
            "default": "",
            "markdownDescription": "Codex home folder (default `$CODEX_HOME` or `~/.codex`).",
            "order": 7
          },
          "promptback.sources.retainDeleted": {
            "type": "boolean",
            "default": false,
            "description": "Keep prompts in the index after their session is deleted from disk.",
            "order": 8
          }
        }
      },
      {
        "id": "embeddings",
        "title": "Semantic Search",
        "order": 3,
        "properties": {
          "promptback.embedding.provider": {
            "type": "string",
            "enum": [
              "local",
              "openai-compatible",
              "none"
            ],
            "enumDescriptions": [
              "Local ONNX model — prompts never leave this machine",
              "Any OpenAI-compatible /embeddings endpoint (Azure OpenAI, Foundry, Ollama, LM Studio). Remote endpoints receive your prompt text.",
              "Keyword search only"
            ],
            "default": "local",
            "markdownDescription": "Embedding backend for semantic search. Changing it re-embeds the index in the background.",
            "order": 0
          },
          "promptback.embedding.model": {
            "type": "string",
            "enum": [
              "bge-small-en-v1.5",
              "all-MiniLM-L6-v2"
            ],
            "default": "bge-small-en-v1.5",
            "markdownDescription": "Local embedding model. `bge-small-en-v1.5` gave the best retrieval quality on real prompt history; `all-MiniLM-L6-v2` is ~2x faster to index.",
            "order": 1
          },
          "promptback.embedding.threads": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 32,
            "description": "CPU threads used for local embedding.",
            "order": 2
          },
          "promptback.embedding.allowDownload": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Allow downloading the pinned, hash-verified model from Hugging Face when it is not bundled or cached. Only model files are downloaded; no prompt text is sent.",
            "order": 3
          },
          "promptback.embedding.modelDir": {
            "type": "string",
            "default": "",
            "markdownDescription": "Folder that already contains the model files (for offline machines). Leave empty to use the bundled or cached model.",
            "order": 4
          },
          "promptback.index.embedOrigins": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "skill",
                "system",
                "autopilot"
              ]
            },
            "default": [
              "human"
            ],
            "description": "Message origins that get semantic embeddings. Others remain keyword-searchable.",
            "order": 5
          }
        }
      },
      {
        "id": "remote",
        "title": "Remote Embeddings (OpenAI-compatible)",
        "order": 4,
        "properties": {
          "promptback.embedding.openai.baseUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "Base URL for `openai-compatible`, e.g. `https://<resource>.openai.azure.com/openai/v1` or `http://localhost:11434/v1`.",
            "order": 0
          },
          "promptback.embedding.openai.model": {
            "type": "string",
            "default": "text-embedding-3-small",
            "description": "Model/deployment name for the openai-compatible provider.",
            "order": 1
          },
          "promptback.embedding.openai.apiKeyEnv": {
            "type": "string",
            "default": "",
            "description": "Name of an environment variable holding the API key (keys are never stored in settings).",
            "order": 2
          },
          "promptback.embedding.openai.dimensions": {
            "type": "number",
            "default": 0,
            "description": "Requested embedding dimensions (0 = model default).",
            "order": 3
          }
        }
      },
      {
        "id": "index",
        "title": "Index",
        "order": 5,
        "properties": {
          "promptback.index.backgroundIntervalMinutes": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "How often to pick up new prompts in the background (0 = only when searching).",
            "order": 0
          },
          "promptback.index.directory": {
            "type": "string",
            "default": "",
            "markdownDescription": "Index location. Empty = `~/.promptback` (or `$PROMPTBACK_HOME`), shared by every VS Code window (including the Agents window), the CLI and the MCP server.",
            "order": 1
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "promptback.searchAll",
          "when": "false"
        },
        {
          "command": "promptback.refreshSidebar",
          "when": "false"
        },
        {
          "command": "promptback.revealPrompt",
          "when": "false"
        },
        {
          "command": "promptback.copyPromptFromTree",
          "when": "false"
        },
        {
          "command": "promptback.openSessionFromTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "promptback.openExplorer",
          "when": "view == promptback.sessions",
          "group": "navigation@1"
        },
        {
          "command": "promptback.search",
          "when": "view == promptback.sessions",
          "group": "navigation@2"
        },
        {
          "command": "promptback.refreshSidebar",
          "when": "view == promptback.sessions",
          "group": "navigation@3"
        },
        {
          "command": "promptback.reindex",
          "when": "view == promptback.index",
          "group": "navigation@1"
        },
        {
          "command": "promptback.showStatus",
          "when": "view == promptback.index",
          "group": "navigation@2"
        },
        {
          "command": "promptback.openIndexPanel",
          "when": "view == promptback.index",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "promptback.copyPromptFromTree",
          "when": "view == promptback.sessions && viewItem == prompt",
          "group": "inline@1"
        },
        {
          "command": "promptback.openSessionFromTree",
          "when": "view == promptback.sessions && viewItem == prompt",
          "group": "inline@2"
        },
        {
          "command": "promptback.revealPrompt",
          "when": "view == promptback.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "promptback.openSessionFromTree",
          "when": "view == promptback.sessions && viewItem == session",
          "group": "inline@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "promptback.explorer",
        "displayName": "Prompt Explorer",
        "selector": [
          {
            "filenamePattern": "promptback:/**"
          }
        ],
        "priority": "default"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "promptback",
        "label": "Promptback"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "promptback",
          "title": "Promptback",
          "icon": "$(history)"
        }
      ]
    },
    "views": {
      "promptback": [
        {
          "id": "promptback.sessions",
          "name": "Recent Sessions",
          "icon": "$(history)",
          "contextualTitle": "Promptback"
        },
        {
          "id": "promptback.index",
          "name": "Index",
          "icon": "$(database)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "promptback.sessions",
        "contents": "No prompts indexed yet. Your Copilot agent and Chat history is scanned in the background.\n[Open Prompt Explorer](command:promptback.openExplorer)\n[Scan Now](command:promptback.reindex)"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "package": "node ./scripts/package.mjs",
    "test:integration": "node ./test/integration/runTest.mjs"
  },
  "dependencies": {
    "@promptback/core": "*",
    "@vscode/codicons": "^0.0.46-24",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0"
  }
}
