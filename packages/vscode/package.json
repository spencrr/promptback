{
  "name": "yesterprompt",
  "displayName": "Yesterprompt",
  "description": "Semantic search over every prompt you've sent to your AI coding agents: Copilot CLI, the VS Code Agents window, autopilot and Chat. Local-first.",
  "version": "0.4.0",
  "private": true,
  "publisher": "spencrr",
  "repository": {
    "type": "git",
    "url": "https://github.com/spencrr/yesterprompt"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "copilot",
    "prompts",
    "history",
    "semantic search",
    "agents"
  ],
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "yesterprompt.search",
        "title": "Quick Search",
        "category": "Yesterprompt",
        "icon": "$(search)"
      },
      {
        "command": "yesterprompt.openExplorer",
        "title": "Open Prompt Explorer",
        "category": "Yesterprompt",
        "icon": "$(table)"
      },
      {
        "command": "yesterprompt.openIndexPanel",
        "title": "Index & Model Settings",
        "category": "Yesterprompt",
        "icon": "$(settings-gear)"
      },
      {
        "command": "yesterprompt.searchAll",
        "title": "Quick Search (Including Agent, Skill and System Messages)",
        "category": "Yesterprompt"
      },
      {
        "command": "yesterprompt.reindex",
        "title": "Re-scan and Index Now",
        "category": "Yesterprompt",
        "icon": "$(sync)"
      },
      {
        "command": "yesterprompt.showStatus",
        "title": "Show Index Status",
        "category": "Yesterprompt",
        "icon": "$(info)"
      },
      {
        "command": "yesterprompt.showLog",
        "title": "Show Log",
        "category": "Yesterprompt"
      },
      {
        "command": "yesterprompt.enableInAgentsWindow",
        "title": "Enable in Agents Window",
        "category": "Yesterprompt"
      },
      {
        "command": "yesterprompt.refreshSidebar",
        "title": "Refresh",
        "category": "Yesterprompt",
        "icon": "$(refresh)"
      },
      {
        "command": "yesterprompt.revealPrompt",
        "title": "Show in Prompt Explorer",
        "category": "Yesterprompt",
        "icon": "$(table)"
      },
      {
        "command": "yesterprompt.copyPromptFromTree",
        "title": "Copy Prompt",
        "category": "Yesterprompt",
        "icon": "$(copy)"
      },
      {
        "command": "yesterprompt.openSessionFromTree",
        "title": "Open Session",
        "category": "Yesterprompt",
        "icon": "$(link-external)"
      }
    ],
    "keybindings": [
      {
        "command": "yesterprompt.search",
        "key": "ctrl+alt+h",
        "mac": "cmd+ctrl+h"
      },
      {
        "command": "yesterprompt.openExplorer",
        "key": "ctrl+alt+e",
        "mac": "cmd+ctrl+e"
      }
    ],
    "configuration": [
      {
        "id": "general",
        "title": "General",
        "order": 1,
        "properties": {
          "yesterprompt.defaultAction": {
            "type": "string",
            "enum": [
              "copy",
              "insert",
              "preview",
              "open"
            ],
            "enumDescriptions": [
              "Copy the prompt to the clipboard",
              "Insert the prompt into the chat input (without sending)",
              "Open the full prompt in a read-only editor",
              "Open or resume the session the prompt came from"
            ],
            "default": "copy",
            "description": "What Enter does on a search result.",
            "order": 0
          },
          "yesterprompt.maxResults": {
            "type": "number",
            "default": 50,
            "minimum": 5,
            "maximum": 500,
            "description": "Maximum results shown in the search picker.",
            "order": 1
          }
        }
      },
      {
        "id": "sources",
        "title": "Sources",
        "order": 2,
        "properties": {
          "yesterprompt.sources.copilot": {
            "type": "boolean",
            "default": true,
            "description": "Index Copilot agent sessions (Agents window, Copilot CLI, autopilot).",
            "order": 0
          },
          "yesterprompt.sources.vscodeChat": {
            "type": "boolean",
            "default": true,
            "description": "Index VS Code Chat panel history (Stable and Insiders).",
            "order": 1
          },
          "yesterprompt.sources.copilotHome": {
            "type": "string",
            "default": "",
            "markdownDescription": "Copilot home folder (default `$COPILOT_HOME` or `~/.copilot`).",
            "order": 2
          },
          "yesterprompt.sources.retainDeleted": {
            "type": "boolean",
            "default": false,
            "description": "Keep prompts in the index after their session is deleted from disk.",
            "order": 3
          }
        }
      },
      {
        "id": "embeddings",
        "title": "Semantic Search",
        "order": 3,
        "properties": {
          "yesterprompt.embedding.provider": {
            "type": "string",
            "enum": [
              "local",
              "openai-compatible",
              "none"
            ],
            "enumDescriptions": [
              "Local ONNX model — prompts never leave this machine",
              "Any OpenAI-compatible /embeddings endpoint (Azure OpenAI, Foundry, Ollama, LM Studio). Remote endpoints receive your prompt text.",
              "Keyword search only"
            ],
            "default": "local",
            "markdownDescription": "Embedding backend for semantic search. Changing it re-embeds the index in the background.",
            "order": 0
          },
          "yesterprompt.embedding.model": {
            "type": "string",
            "enum": [
              "bge-small-en-v1.5",
              "all-MiniLM-L6-v2"
            ],
            "default": "bge-small-en-v1.5",
            "markdownDescription": "Local embedding model. `bge-small-en-v1.5` gave the best retrieval quality on real prompt history; `all-MiniLM-L6-v2` is ~2x faster to index.",
            "order": 1
          },
          "yesterprompt.embedding.threads": {
            "type": "number",
            "default": 4,
            "minimum": 1,
            "maximum": 32,
            "description": "CPU threads used for local embedding.",
            "order": 2
          },
          "yesterprompt.embedding.allowDownload": {
            "type": "boolean",
            "default": true,
            "markdownDescription": "Allow downloading the pinned, hash-verified model from Hugging Face when it is not bundled or cached. Only model files are downloaded; no prompt text is sent.",
            "order": 3
          },
          "yesterprompt.embedding.modelDir": {
            "type": "string",
            "default": "",
            "markdownDescription": "Folder that already contains the model files (for offline machines). Leave empty to use the bundled or cached model.",
            "order": 4
          },
          "yesterprompt.index.embedOrigins": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "human",
                "agent",
                "skill",
                "system",
                "autopilot"
              ]
            },
            "default": [
              "human"
            ],
            "description": "Message origins that get semantic embeddings. Others remain keyword-searchable.",
            "order": 5
          }
        }
      },
      {
        "id": "remote",
        "title": "Remote Embeddings (OpenAI-compatible)",
        "order": 4,
        "properties": {
          "yesterprompt.embedding.openai.baseUrl": {
            "type": "string",
            "default": "",
            "markdownDescription": "Base URL for `openai-compatible`, e.g. `https://<resource>.openai.azure.com/openai/v1` or `http://localhost:11434/v1`.",
            "order": 0
          },
          "yesterprompt.embedding.openai.model": {
            "type": "string",
            "default": "text-embedding-3-small",
            "description": "Model/deployment name for the openai-compatible provider.",
            "order": 1
          },
          "yesterprompt.embedding.openai.apiKeyEnv": {
            "type": "string",
            "default": "",
            "description": "Name of an environment variable holding the API key (keys are never stored in settings).",
            "order": 2
          },
          "yesterprompt.embedding.openai.dimensions": {
            "type": "number",
            "default": 0,
            "description": "Requested embedding dimensions (0 = model default).",
            "order": 3
          }
        }
      },
      {
        "id": "index",
        "title": "Index",
        "order": 5,
        "properties": {
          "yesterprompt.index.backgroundIntervalMinutes": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "description": "How often to pick up new prompts in the background (0 = only when searching).",
            "order": 0
          },
          "yesterprompt.index.directory": {
            "type": "string",
            "default": "",
            "markdownDescription": "Index location. Empty = `~/.yesterprompt` (or `$YESTERPROMPT_HOME`), shared by every VS Code window (including the Agents window), the CLI and the MCP server.",
            "order": 1
          }
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "yesterprompt.searchAll",
          "when": "false"
        },
        {
          "command": "yesterprompt.refreshSidebar",
          "when": "false"
        },
        {
          "command": "yesterprompt.revealPrompt",
          "when": "false"
        },
        {
          "command": "yesterprompt.copyPromptFromTree",
          "when": "false"
        },
        {
          "command": "yesterprompt.openSessionFromTree",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "yesterprompt.openExplorer",
          "when": "view == yesterprompt.sessions",
          "group": "navigation@1"
        },
        {
          "command": "yesterprompt.search",
          "when": "view == yesterprompt.sessions",
          "group": "navigation@2"
        },
        {
          "command": "yesterprompt.refreshSidebar",
          "when": "view == yesterprompt.sessions",
          "group": "navigation@3"
        },
        {
          "command": "yesterprompt.reindex",
          "when": "view == yesterprompt.index",
          "group": "navigation@1"
        },
        {
          "command": "yesterprompt.showStatus",
          "when": "view == yesterprompt.index",
          "group": "navigation@2"
        },
        {
          "command": "yesterprompt.openIndexPanel",
          "when": "view == yesterprompt.index",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "yesterprompt.copyPromptFromTree",
          "when": "view == yesterprompt.sessions && viewItem == prompt",
          "group": "inline@1"
        },
        {
          "command": "yesterprompt.openSessionFromTree",
          "when": "view == yesterprompt.sessions && viewItem == prompt",
          "group": "inline@2"
        },
        {
          "command": "yesterprompt.revealPrompt",
          "when": "view == yesterprompt.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "yesterprompt.openSessionFromTree",
          "when": "view == yesterprompt.sessions && viewItem == session",
          "group": "inline@2"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "yesterprompt.explorer",
        "displayName": "Prompt Explorer",
        "selector": [
          {
            "filenamePattern": "yesterprompt:/**"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yesterprompt",
          "title": "Yesterprompt",
          "icon": "$(history)"
        }
      ]
    },
    "views": {
      "yesterprompt": [
        {
          "id": "yesterprompt.sessions",
          "name": "Recent Sessions",
          "icon": "$(history)",
          "contextualTitle": "Yesterprompt"
        },
        {
          "id": "yesterprompt.index",
          "name": "Index",
          "icon": "$(database)",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "yesterprompt.sessions",
        "contents": "No prompts indexed yet. Your Copilot agent and Chat history is scanned in the background.\n[Open Prompt Explorer](command:yesterprompt.openExplorer)\n[Scan Now](command:yesterprompt.reindex)"
      }
    ]
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "watch": "node ./scripts/build.mjs --watch",
    "package": "node ./scripts/package.mjs",
    "test:integration": "node ./test/integration/runTest.mjs"
  },
  "dependencies": {
    "@yesterprompt/core": "*",
    "@vscode/codicons": "^0.0.46-24",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0"
  }
}
