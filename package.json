{
  "name": "promptback-monorepo",
  "private": true,
  "version": "0.6.0",
  "description": "Semantic search over every prompt you've sent to your AI coding agents. Local-first.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spencrr/promptback.git"
  },
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/vscode"
  ],
  "engines": {
    "node": ">=22.16",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build -w packages/cli && npm run build -w packages/vscode",
    "typecheck": "tsc -p packages/core && tsc -p packages/cli && tsc -p packages/vscode && tsc -p packages/vscode/webview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "package": "npm run package -w packages/vscode",
    "bench": "npm run bench -w packages/core",
    "prepare": "lefthook install",
    "hooks:run": "lefthook run pre-commit --all-files"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "^22.16.0",
    "esbuild": "^0.28.2",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@vscode/vsce-sign": false,
    "esbuild": false,
    "keytar": false,
    "onnxruntime-node": false,
    "lefthook": false
  }
}
